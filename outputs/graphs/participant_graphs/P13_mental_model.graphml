<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="category" attr.type="string" />
  <key id="d1" for="graph" attr.name="role_background" attr.type="string" />
  <key id="d0" for="graph" attr.name="participant_id" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="Humans">
      <data key="d2">Human Agency</data>
    </node>
    <node id="Bias">
      <data key="d2">Ethics &amp; Governance</data>
    </node>
    <node id="AI">
      <data key="d2">Core Entity</data>
    </node>
    <node id="Data">
      <data key="d2">Technical Infrastructure</data>
    </node>
    <node id="Jobs">
      <data key="d2">Socio-Economic Impact</data>
    </node>
    <node id="Trust">
      <data key="d2">Ethics &amp; Governance</data>
    </node>
    <edge source="Humans" target="Bias">
      <data key="d3">1.0</data>
    </edge>
    <edge source="Humans" target="AI">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Bias" target="AI">
      <data key="d3">1.0</data>
    </edge>
    <edge source="Bias" target="Data">
      <data key="d3">0.5</data>
    </edge>
    <edge source="AI" target="Data">
      <data key="d3">1.0</data>
    </edge>
    <edge source="AI" target="Jobs">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Data" target="Jobs">
      <data key="d3">1.0</data>
    </edge>
    <edge source="Data" target="Trust">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Jobs" target="Trust">
      <data key="d3">1.0</data>
    </edge>
    <data key="d0">P13</data>
    <data key="d1">Sociologist</data>
  </graph>
</graphml>
