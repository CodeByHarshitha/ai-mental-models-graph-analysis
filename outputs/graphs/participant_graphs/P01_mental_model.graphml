<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d3" for="edge" attr.name="weight" attr.type="double" />
  <key id="d2" for="node" attr.name="category" attr.type="string" />
  <key id="d1" for="graph" attr.name="role_background" attr.type="string" />
  <key id="d0" for="graph" attr.name="participant_id" attr.type="string" />
  <graph edgedefault="undirected">
    <node id="AI">
      <data key="d2">Core Entity</data>
    </node>
    <node id="Algorithms">
      <data key="d2">Technical Infrastructure</data>
    </node>
    <node id="Data">
      <data key="d2">Technical Infrastructure</data>
    </node>
    <node id="Learning">
      <data key="d2">Technical Infrastructure</data>
    </node>
    <node id="Automation">
      <data key="d2">Application &amp; Impact</data>
    </node>
    <edge source="AI" target="Algorithms">
      <data key="d3">1.0</data>
    </edge>
    <edge source="AI" target="Data">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Algorithms" target="Data">
      <data key="d3">1.0</data>
    </edge>
    <edge source="Algorithms" target="Learning">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Data" target="Learning">
      <data key="d3">1.0</data>
    </edge>
    <edge source="Data" target="Automation">
      <data key="d3">0.5</data>
    </edge>
    <edge source="Learning" target="Automation">
      <data key="d3">1.0</data>
    </edge>
    <data key="d0">P01</data>
    <data key="d1">Software Engineer</data>
  </graph>
</graphml>
